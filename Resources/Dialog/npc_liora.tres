[sub_resource type="Resource" id="before"]
script = ExtResource("entry")
id = "before"
text = Array[String](["Liora turns through a few graceful steps, her ribbons catching the breeze.", "I'm preparing a little dance for the watch. Captain Rowan is near the steps if you'd like to help."])
state = 0
options = Array[ExtResource("option")]([])
flags = Array[int]([])

[sub_resource type="Resource" id="invite"]
script = ExtResource("entry")
id = "invite"
text = Array[String](["Captain Rowan sent you? I thought he'd be far too busy for a performance.", "Would you invite him for me? Tell him I'll save a dance until his watch is over."])
state = 2
options = Array[ExtResource("option")]([])
flags = Array[int]([4])

[sub_resource type="Resource" id="waiting"]
script = ExtResource("entry")
id = "waiting"
text = Array[String](["Would you take my invitation to Captain Rowan by the steps? I'll keep rehearsing here."])
state = 2
options = Array[ExtResource("option")]([])
flags = Array[int]([])

[sub_resource type="Resource" id="ready"]
script = ExtResource("entry")
id = "ready"
text = Array[String](["He'll come after his watch? Wonderful! Thank you for asking him.", "While we wait, would you like to see the encore I've been practicing?"])
state = 2
options = Array[ExtResource("option")]([SubResource("Perform"), SubResource("Later")])
flags = Array[int]([])

[sub_resource type="Resource" id="finish"]
script = ExtResource("entry")
id = "finish"
text = Array[String](["Liora traces a bright circle through the flowers, her skirts following the rhythm of a melody carried on the wind.", "Thank you for bringing a little company to the meadow. Quest complete: 25 XP."])
state = 2
options = Array[ExtResource("option")]([])
flags = Array[int]([])

[sub_resource type="Resource" id="after"]
script = ExtResource("entry")
id = "after"
text = Array[String](["There is always room for one more in the audience. Thank you again for helping us."])
state = 2
options = Array[ExtResource("option")]([])
flags = Array[int]([])

